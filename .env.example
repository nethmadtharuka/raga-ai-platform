# Copy to .env and fill in values (never commit .env)
# Google AI Studio / Cloud: create a key and rotate any key that was ever committed to git.

GEMINI_API_KEY=

# Optional: Gemini text models (defaults: gemini-flash-latest, falling back to gemini-flash-lite-latest on quota errors)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Protects REST API and webhooks (send header: X-API-Key: <value>)
APP_API_KEY=

# Optional: separate key for automation (webhooks accept APP_API_KEY or this value)
WEBHOOK_API_KEY=

CHROMA_URL=http://localhost:8000

# Docker Compose (optional): host port for the backend container (default 8090)
# RAGA_PORT=8090
# Local runs: scripts/dev-backend.ps1 loads this file and uses http://localhost:8000 and port 8090.
