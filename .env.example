# Copy to .env and fill in values (never commit .env)
# Google AI Studio / Cloud: create a key and rotate any key that was ever committed to git.

GEMINI_API_KEY=

# Protects REST API and webhooks (send header: X-API-Key: <value>)
APP_API_KEY=

# Optional: separate key for automation (webhooks accept APP_API_KEY or this value)
WEBHOOK_API_KEY=

CHROMA_URL=http://localhost:8000

# Docker Compose (optional)
# SERVER_PORT=8080
